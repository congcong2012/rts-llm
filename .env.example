# ─────────────────────────────────────────────────────────────────────────────
# RTS MVP — environment template.  Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. Everything here has a safe
# default: the project runs with NO `.env` at all (the red player is then driven
# by the built-in rule commander, so the game is fully playable).
#
# Phases: 1 = simulation core (✅), 2 = renderer + human control (✅),
#         3 = full match vs rule AI, 4 = LLM commander, 5 = polish.
# Variables marked "(phase 4)" are declared now but not read yet.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# HTTP + WebSocket port. Vite proxies /api and /ws here in development.
PORT=3001

# ── Renderer dev server (Vite) ───────────────────────────────────────────────
# Port the browser connects to: http://localhost:5173
VITE_PORT=5173

# ── Opponent commander (phase 2 / 3) ─────────────────────────────────────────
# on  → the red player is driven by the built-in rule AI (default)
# off → peaceful sandbox with no opponent activity; handy for learning the
#       controls or running the interaction acceptance checks
OPPONENT=on

# ── LLM provider (OpenAI-compatible) — phase 4 ───────────────────────────────
# SECURITY: the key is read on the server only and is never sent to the client,
# and it is redacted from every log line.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── LLM commander behaviour — phase 4 ────────────────────────────────────────
# When false (or when OPENAI_API_KEY is empty) the red player is driven by the
# built-in rule AI instead of an LLM, so the game stays fully playable.
LLM_ENABLED=true
LLM_TIMEOUT_MS=3000
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_DECIDE_INTERVAL_TICKS=20
LLM_MAX_ACTIONS_PER_TURN=12
LLM_COOLDOWN_TICKS=300

# ── Simulation ───────────────────────────────────────────────────────────────
# Fixed seed => reproducible map AND reproducible match (same command log).
# Leave empty for a random seed.
GAME_SEED=12345

# ── Fog of war ───────────────────────────────────────────────────────────────
# Both players are equally limited by fog. Setting this to false only lifts the
# restriction for the human (debugging); the LLM is ALWAYS fog-limited.
FOG_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
# debug also records full LLM request bodies (secrets are still redacted).
LOG_LEVEL=info
# Directory that receives `<LOG_FILE>.log` plus a `rejects.log` of dropped orders.
LOG_DIR=logs
# Base name of the server log file (defaults to `server`).
LOG_FILE=server

# ── Browser acceptance harness (scripts/browser-acceptance.cjs) ──────────────
# Only needed to run the automated B1..B8 walkthrough. It needs a real
# Chromium plus the `playwright-core` package; see README.md § Testing.
#   CHROME_PATH  path to chrome.exe / chromium / google-chrome
#   PLAYWRIGHT   directory of the playwright-core module
#   RTS_URL      client URL (default http://localhost:5173/)
# CHROME_PATH=
# PLAYWRIGHT=playwright-core
# RTS_URL=http://localhost:5173/
